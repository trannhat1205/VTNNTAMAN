rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.uid == 'Gu6OYdsdiWbRvbEINqaWZXj3LV83' ||
        request.auth.token.email_verified == true
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPrimaryAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'Gu6OYdsdiWbRvbEINqaWZXj3LV83' ||
        (isVerified() && request.auth.token.email == 'trannhat1205@gmail.com')
      );
    }

    function isAdmin() {
      return isPrimaryAdmin() || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function canAccessChatRoom(roomId) {
      return isSignedIn() && isValidId(roomId) && (
        roomId == 'general_all_staff' ||
        isPrimaryAdmin() ||
        roomId.matches('^dm_' + request.auth.uid + '__[a-zA-Z0-9_\\-]+$') ||
        roomId.matches('^dm_[a-zA-Z0-9_\\-]+__' + request.auth.uid + '$')
      );
    }

    // Validation Blueprints
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'note', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
        data.createdAt is timestamp;
    }

    function isValidStaffPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'active', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'role', 'active', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.role is string && data.role.size() <= 20 && (data.role == 'manager' || data.role == 'staff') &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStaffPrivate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomer(data, customerId) {
      return data.keys().hasAll([
          'id', 'code', 'name', 'group', 'totalPurchased',
          'totalDebt', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'name', 'group', 'totalPurchased',
          'totalDebt', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == customerId &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.group is string && data.group.size() >= 1 && data.group.size() <= 40 &&
        data.totalPurchased is number && data.totalPurchased >= 0 &&
        data.totalDebt is number && data.totalDebt >= 0 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCustomerPrivate(data, customerId) {
      return data.keys().hasAll([
          'id', 'phone', 'email', 'address', 'note',
          'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'phone', 'email', 'address', 'note',
          'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == customerId &&
        data.phone is string && data.phone.size() >= 1 && data.phone.size() <= 30 &&
        data.email is string && data.email.size() <= 150 &&
        data.address is string && data.address.size() <= 250 &&
        data.note is string && data.note.size() <= 300 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidNotificationPrefs(data, userId) {
      return data.keys().hasAll([
          'uid', 'debtCustomerEnabled', 'debtSupplierEnabled',
          'lowStockEnabled', 'periodicReportEnabled',
          'browserPushEnabled', 'leadDays', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'debtCustomerEnabled', 'debtSupplierEnabled',
          'lowStockEnabled', 'periodicReportEnabled',
          'browserPushEnabled', 'leadDays', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == userId &&
        data.debtCustomerEnabled is bool &&
        data.debtSupplierEnabled is bool &&
        data.lowStockEnabled is bool &&
        data.periodicReportEnabled is bool &&
        data.browserPushEnabled is bool &&
        data.leadDays is number && data.leadDays >= 1 && data.leadDays <= 30 &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'code', 'name', 'category', 'unit',
          'importPrice', 'sellPrice', 'stock', 'minStock',
          'supplierName', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'name', 'category', 'unit',
          'importPrice', 'sellPrice', 'stock', 'minStock',
          'supplierName', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == productId &&
        data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 50 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30 &&
        data.importPrice is number && data.importPrice >= 0 &&
        data.sellPrice is number && data.sellPrice >= 0 &&
        data.stock is number && data.stock >= 0 &&
        data.minStock is number && data.minStock >= 0 &&
        data.supplierName is string && data.supplierName.size() <= 150 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSaleRecord(data, saleId) {
      return data.keys().hasAll([
          'id', 'invoiceCode', 'customerId', 'customerName', 'customerPhone',
          'productId', 'productName', 'unit', 'quantity', 'unitPrice',
          'totalAmount', 'paidAmount', 'debtAmount', 'dueDate',
          'status', 'note', 'staffName', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'invoiceCode', 'customerId', 'customerName', 'customerPhone',
          'productId', 'productName', 'unit', 'quantity', 'unitPrice',
          'totalAmount', 'paidAmount', 'debtAmount', 'dueDate',
          'status', 'note', 'staffName', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == saleId &&
        data.invoiceCode is string && data.invoiceCode.size() >= 1 && data.invoiceCode.size() <= 40 &&
        data.customerId is string && data.customerId.size() >= 1 && data.customerId.size() <= 128 && data.customerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120 &&
        data.customerPhone is string && data.customerPhone.size() <= 30 &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 && data.productId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 150 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30 &&
        data.quantity is number && data.quantity > 0 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.totalAmount is number && data.totalAmount >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 &&
        data.debtAmount is number && data.debtAmount >= 0 &&
        data.dueDate is string && data.dueDate.size() <= 30 &&
        data.status is string && data.status.size() <= 20 && (data.status == 'paid' || data.status == 'partial' || data.status == 'unpaid') &&
        data.note is string && data.note.size() <= 300 &&
        data.staffName is string && data.staffName.size() <= 100 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidImportRecord(data, importId) {
      return data.keys().hasAll([
          'id', 'receiptCode', 'supplierName', 'supplierPhone',
          'productId', 'productName', 'unit', 'quantity', 'unitCost',
          'totalCost', 'paidAmount', 'debtAmount', 'dueDate',
          'status', 'note', 'staffName', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'receiptCode', 'supplierName', 'supplierPhone',
          'productId', 'productName', 'unit', 'quantity', 'unitCost',
          'totalCost', 'paidAmount', 'debtAmount', 'dueDate',
          'status', 'note', 'staffName', 'ownerId', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == importId &&
        data.receiptCode is string && data.receiptCode.size() >= 1 && data.receiptCode.size() <= 40 &&
        data.supplierName is string && data.supplierName.size() >= 1 && data.supplierName.size() <= 150 &&
        data.supplierPhone is string && data.supplierPhone.size() <= 30 &&
        data.productId is string && data.productId.size() >= 1 && data.productId.size() <= 128 && data.productId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 150 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30 &&
        data.quantity is number && data.quantity > 0 &&
        data.unitCost is number && data.unitCost >= 0 &&
        data.totalCost is number && data.totalCost >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 &&
        data.debtAmount is number && data.debtAmount >= 0 &&
        data.dueDate is string && data.dueDate.size() <= 30 &&
        data.status is string && data.status.size() <= 20 && (data.status == 'paid' || data.status == 'partial' || data.status == 'unpaid') &&
        data.note is string && data.note.size() <= 300 &&
        data.staffName is string && data.staffName.size() <= 100 &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBackupRecord(data, backupId) {
      return data.keys().hasAll([
          'id', 'fileName', 'driveFileId', 'targetEmail',
          'recordCount', 'status', 'triggerType', 'ownerId', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'fileName', 'driveFileId', 'targetEmail',
          'recordCount', 'status', 'triggerType', 'ownerId', 'createdAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == backupId &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 150 &&
        data.driveFileId is string && data.driveFileId.size() >= 1 && data.driveFileId.size() <= 128 &&
        data.targetEmail is string && data.targetEmail.size() >= 3 && data.targetEmail.size() <= 150 &&
        data.recordCount is number && data.recordCount >= 0 &&
        data.status is string && data.status.size() <= 20 && (data.status == 'completed' || data.status == 'failed') &&
        data.triggerType is string && data.triggerType.size() <= 20 && (data.triggerType == 'auto_daily' || data.triggerType == 'manual') &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.createdAt is timestamp;
    }

    function isValidAiTokenGrant(data, accountId) {
      return data.keys().hasAll([
          'accountId', 'date', 'bonusTokens', 'lastGrantedAmount',
          'grantedByUid', 'grantedByName', 'note', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'accountId', 'date', 'bonusTokens', 'lastGrantedAmount',
          'grantedByUid', 'grantedByName', 'note', 'updatedAt'
        ]) &&
        data.accountId is string && isValidId(data.accountId) && data.accountId == accountId &&
        data.date is string && data.date.size() == 10 &&
        data.bonusTokens is number && data.bonusTokens >= 0 && data.bonusTokens <= 5000000 &&
        data.lastGrantedAmount is number && data.lastGrantedAmount >= 0 && data.lastGrantedAmount <= 5000000 &&
        data.grantedByUid is string && isValidId(data.grantedByUid) &&
        data.grantedByName is string && data.grantedByName.size() >= 1 && data.grantedByName.size() <= 120 &&
        data.note is string && data.note.size() <= 300 &&
        data.updatedAt is timestamp;
    }

    function isValidChatUserDirectory(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'warehouseName', 'isPrimaryAdmin', 'roleLabel', 'lastSeenAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'warehouseName', 'isPrimaryAdmin', 'roleLabel', 'lastSeenAt'
        ]) &&
        data.uid is string && isValidId(data.uid) && data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.warehouseName is string && data.warehouseName.size() <= 150 &&
        data.isPrimaryAdmin is bool &&
        data.roleLabel is string && data.roleLabel.size() <= 120 &&
        data.lastSeenAt is timestamp;
    }

    function isValidChatRoom(data, roomId) {
      return data.keys().hasAll([
          'roomId', 'roomType', 'title', 'participants', 'lastMessageText',
          'lastMessageType', 'lastSenderUid', 'lastSenderName', 'lastMessageAtMs', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'roomId', 'roomType', 'title', 'participants', 'lastMessageText',
          'lastMessageType', 'lastSenderUid', 'lastSenderName', 'lastMessageAtMs', 'updatedAt'
        ]) &&
        data.roomId is string && isValidId(data.roomId) && data.roomId == roomId &&
        data.roomType is string && (data.roomType == 'group' || data.roomType == 'dm') &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
        data.participants is list && data.participants.size() <= 100 &&
        data.lastMessageText is string && data.lastMessageText.size() <= 500 &&
        data.lastMessageType is string &&
        (data.lastMessageType == 'text' || data.lastMessageType == 'media' || data.lastMessageType == 'token_request' || data.lastMessageType == 'token_grant') &&
        data.lastSenderUid is string && isValidId(data.lastSenderUid) &&
        data.lastSenderName is string && data.lastSenderName.size() >= 1 && data.lastSenderName.size() <= 120 &&
        data.lastMessageAtMs is number && data.lastMessageAtMs >= 0 &&
        data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, roomId, messageId) {
      return data.keys().hasAll([
          'id', 'roomId', 'senderUid', 'senderName', 'senderWarehouse',
          'text', 'messageType', 'attachments', 'tokenAmount', 'targetUid',
          'createdAtMs', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'roomId', 'senderUid', 'senderName', 'senderWarehouse',
          'text', 'messageType', 'attachments', 'tokenAmount', 'targetUid',
          'createdAtMs', 'createdAt'
        ]) &&
        data.id is string && isValidId(data.id) && data.id == messageId &&
        data.roomId is string && isValidId(data.roomId) && data.roomId == roomId &&
        data.senderUid is string && isValidId(data.senderUid) &&
        data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120 &&
        data.senderWarehouse is string && data.senderWarehouse.size() <= 150 &&
        data.text is string && data.text.size() <= 4000 &&
        data.messageType is string &&
        (data.messageType == 'text' || data.messageType == 'media' || data.messageType == 'token_request' || data.messageType == 'token_grant') &&
        data.attachments is list && data.attachments.size() <= 5 &&
        data.tokenAmount is number && data.tokenAmount >= 0 && data.tokenAmount <= 5000000 &&
        data.targetUid is string && data.targetUid.size() <= 128 &&
        data.createdAtMs is number && data.createdAtMs >= 0 &&
        data.createdAt is timestamp;
    }

    // Collection 1: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(adminId) && isValidAdminRecord(incoming()) &&
        incoming().uid == adminId && incoming().createdAt == request.time && isAdmin();
      allow update: if isVerified() && isValidId(adminId) && isValidAdminRecord(incoming()) &&
        incoming().uid == existing().uid && incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['note']) && isAdmin();
      allow delete: if isVerified() && isValidId(adminId) && isAdmin();
    }

    // Collection 2: /staff/{userId}
    match /staff/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(userId) && isValidStaffPublic(incoming(), userId) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (
          (isOwner(userId) && incoming().role == 'staff') ||
          isAdmin()
        );
      allow update: if isVerified() && isValidId(userId) && isValidStaffPublic(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'active', 'updatedAt'])) ||
          (isOwner(userId) && incoming().role == existing().role && incoming().active == existing().active &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    // Collection 3: /staff_private/{userId} (PII Isolated)
    match /staff_private/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(userId) && isValidStaffPrivate(incoming(), userId) &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time &&
        (isOwner(userId) || isAdmin()) &&
        exists(/databases/$(database)/documents/staff/$(userId));
      allow update: if isVerified() && isValidId(userId) && isValidStaffPrivate(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isOwner(userId) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'updatedAt']);
      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    // Collection 4: /customers/{customerId}
    match /customers/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(customerId) && isValidCustomer(incoming(), customerId) &&
        (incoming().ownerId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(customerId) && isValidCustomer(incoming(), customerId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['totalPurchased', 'totalDebt', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['code', 'name', 'group', 'totalPurchased', 'totalDebt', 'updatedAt'])
        );
      allow delete: if isVerified() && isValidId(customerId) && isAdmin();
    }

    // Collection 5: /customers_private/{customerId} (Isolated Customer PII)
    match /customers_private/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(customerId) && isValidCustomerPrivate(incoming(), customerId) &&
        (incoming().ownerId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/customers/$(customerId));
      allow update: if isVerified() && isValidId(customerId) && isValidCustomerPrivate(incoming(), customerId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'email', 'address', 'note', 'updatedAt']);
      allow delete: if isVerified() && isValidId(customerId) && isAdmin();
    }

    // Collection 6: /notification_prefs/{userId}
    match /notification_prefs/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(userId) && isValidNotificationPrefs(incoming(), userId) &&
        (isOwner(userId) || isAdmin()) &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(userId) && isValidNotificationPrefs(incoming(), userId) &&
        incoming().uid == existing().uid &&
        (isOwner(userId) || isAdmin()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'debtCustomerEnabled', 'debtSupplierEnabled',
          'lowStockEnabled', 'periodicReportEnabled',
          'browserPushEnabled', 'leadDays', 'updatedAt'
        ]);
      allow delete: if isVerified() && isValidId(userId) && isAdmin();
    }

    // Collection 7: /products/{productId}
    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(productId) && isValidProduct(incoming(), productId) &&
        (incoming().ownerId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(productId) && isValidProduct(incoming(), productId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          ((existing().ownerId == request.auth.uid || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'importPrice', 'updatedAt'])) ||
          ((existing().ownerId == request.auth.uid || isAdmin()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'code', 'name', 'category', 'unit', 'importPrice',
              'sellPrice', 'stock', 'minStock', 'supplierName', 'updatedAt'
            ]))
        );
      allow delete: if isVerified() && isValidId(productId) && isAdmin();
    }

    // Collection 8: /sales/{saleId}
    match /sales/{saleId} {
      allow get: if isSignedIn() && isValidId(saleId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(saleId) && isValidSaleRecord(incoming(), saleId) &&
        (incoming().ownerId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isVerified() && isValidId(saleId) && isValidSaleRecord(incoming(), saleId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().productId == existing().productId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (existing().ownerId == request.auth.uid &&
            existing().status != 'paid' &&
            incoming().paidAmount >= existing().paidAmount &&
            incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'debtAmount', 'status', 'note', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(saleId) && isAdmin();
    }

    // Collection 9: /imports/{importId}
    match /imports/{importId} {
      allow get: if isSignedIn() && isValidId(importId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(importId) && isValidImportRecord(incoming(), importId) &&
        (incoming().ownerId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/products/$(incoming().productId));
      allow update: if isVerified() && isValidId(importId) && isValidImportRecord(incoming(), importId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().productId == existing().productId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (existing().ownerId == request.auth.uid &&
            existing().status != 'paid' &&
            incoming().paidAmount >= existing().paidAmount &&
            incoming().diff(existing()).affectedKeys().hasOnly(['paidAmount', 'debtAmount', 'status', 'note', 'updatedAt']))
        );
      allow delete: if isVerified() && isValidId(importId) && isAdmin();
    }

    // Collection 10: /backups/{backupId}
    match /backups/{backupId} {
      allow get: if isSignedIn() && isValidId(backupId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(backupId) && isValidBackupRecord(incoming(), backupId) &&
        (incoming().ownerId == request.auth.uid || isAdmin()) &&
        incoming().createdAt == request.time;
      allow update: if isVerified() && isValidId(backupId) && isValidBackupRecord(incoming(), backupId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        isAdmin() &&
        existing().status != 'completed' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'recordCount']);
      allow delete: if isVerified() && isValidId(backupId) && isAdmin();
    }

    // Collection 11: /ai_token_grants/{accountId} (Primary Admin grants bonus AI tokens)
    match /ai_token_grants/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (isOwner(accountId) || isPrimaryAdmin());
      allow list: if isPrimaryAdmin();
      allow create, update: if isPrimaryAdmin() && isValidId(accountId) &&
        isValidAiTokenGrant(incoming(), accountId) &&
        incoming().grantedByUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if isPrimaryAdmin() && isValidId(accountId);
    }

    // Collection 12: /chat_users/{userId} (Internal Chat Directory)
    match /chat_users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(userId) &&
        (isOwner(userId) || isPrimaryAdmin()) &&
        isValidChatUserDirectory(incoming(), userId) &&
        (incoming().isPrimaryAdmin == false || isPrimaryAdmin()) &&
        incoming().lastSeenAt == request.time;
      allow delete: if isPrimaryAdmin() && isValidId(userId);
    }

    // Collection 13: /chat_rooms/{roomId} (Internal Zalo-like Chat Rooms)
    match /chat_rooms/{roomId} {
      allow get: if canAccessChatRoom(roomId);
      allow list: if isSignedIn() && (
        existing().roomType == 'group' ||
        request.auth.uid in existing().participants ||
        isPrimaryAdmin()
      );
      allow create, update: if canAccessChatRoom(roomId) &&
        isValidChatRoom(incoming(), roomId) &&
        incoming().lastSenderUid == request.auth.uid &&
        incoming().updatedAt == request.time;
      allow delete: if isPrimaryAdmin() && isValidId(roomId);

      // Collection 14: /chat_rooms/{roomId}/messages/{messageId}
      match /messages/{messageId} {
        allow get, list: if canAccessChatRoom(roomId);
        allow create: if canAccessChatRoom(roomId) && isValidId(messageId) &&
          isValidChatMessage(incoming(), roomId, messageId) &&
          incoming().senderUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          (incoming().messageType != 'token_grant' || isPrimaryAdmin());
        allow update: if false;
        allow delete: if isPrimaryAdmin() && canAccessChatRoom(roomId);
      }
    }
  }
}
