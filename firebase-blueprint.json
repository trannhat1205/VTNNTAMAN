    "NotificationPrefs": {
      "title": "NotificationPrefs",
      "description": "User-customizable push notification preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtCustomerEnabled": {
          "type": "boolean"
        },
        "debtSupplierEnabled": {
          "type": "boolean"
        },
        "lowStockEnabled": {
          "type": "boolean"
        },
        "periodicReportEnabled": {
          "type": "boolean"
        },
        "browserPushEnabled": {
          "type": "boolean"
        },
        "leadDays": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
