  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminRecord"
      },
      "description": "Admin role assignment table."
    },
    "/staff/{userId}": {
      "schema": {
        "$ref": "#/entities/StaffPublic"
      },
      "description": "Public staff profile and role registry."
    },
    "/staff_private/{userId}": {
      "schema": {
        "$ref": "#/entities/StaffPrivate"
      },
      "description": "Isolated PII contact info for staff."
    },
    "/customers/{customerId}": {
      "schema": {
        "$ref": "#/entities/Customer"
      },
      "description": "Customer profile and aggregated purchase/debt metrics."
    },
    "/customers_private/{customerId}": {
      "schema": {
        "$ref": "#/entities/CustomerPrivate"
      },
      "description": "Isolated PII contact details (phone, email, address) for customers."
    },
    "/notification_prefs/{userId}": {
      "schema": {
        "$ref": "#/entities/NotificationPrefs"
      },
      "description": "User-customizable push notification preferences."
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Inventory catalog of agricultural supplies."
    },
    "/sales/{saleId}": {
      "schema": {
        "$ref": "#/entities/SaleRecord"
      },
      "description": "Sales log and customer debt records."
    },
    "/imports/{importId}": {
      "schema": {
        "$ref": "#/entities/ImportRecord"
      },
      "description": "Purchase/import log and supplier debt records."
    },
    "/backups/{backupId}": {
      "schema": {
        "$ref": "#/entities/BackupRecord"
      },
      "description": "Google Drive backup history logs."
    }
  }
}
